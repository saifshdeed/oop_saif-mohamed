package javaapplication191;
import java.util.Scanner;

/**
 *
 * @author Student
 */
public class GuessingGame {
    public int generateSecret() {
        return (int) (Math.random() * 50) + 1;
    }
    public String checkGuess(int guess, int secret) {
        if (guess == secret) {
            return "Correct";
        } else if (guess < secret) {
            return "Higher";
        } else {
            return "Lower";
        }
    }

    public static void main(String[] args) {
        Scanner input = new Scanner(System.in);
        GuessingGame game = new GuessingGame();
        int secret = game.generateSecret();
        int[] guesses = new int[5];
        boolean correct = false;
        for (int i = 0; i < 5; i++) {
            System.out.print("Guess: ");
            guesses[i] = input.nextInt();
            String result = game.checkGuess(guesses[i], secret);
            if (result.equals("Correct")) {
                System.out.println("Correct in " + (i + 1) + " attempts");
                correct = true;
                break;
            } else {
                System.out.println(result);
            }
        }

        if (!correct) {
            System.out.println("The secret number was: " + secret);
        }

        input.close();
    }
}

