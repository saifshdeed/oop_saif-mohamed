package javaapplication236;
public class JavaApplication236 {
    private String invoiceID;
    private double discount;
    private double totalInvoice;

    public JavaApplication236() {
        invoiceID = "1";
        discount = 2.5;
        totalInvoice = 100;
    }

    public JavaApplication236(String id, double d, double total) {
        invoiceID = id;
        discount = d;
        totalInvoice = total;
    }

    public String getInvoiceID() {
        return invoiceID;
    }

    public double getDiscount() {
        return discount;
    }

    public double getTotalInvoice() {
        return totalInvoice;
    }

    public void setDiscount(double discount) {
        this.discount = discount;
    }

    public void setTotalInvoice(double totalInvoice) {
        this.totalInvoice = totalInvoice;
    }

    public double calculateDiscountPrice() {
        return totalInvoice - (totalInvoice * discount / 100);
    }

    public static void main(String[] args) {

        JavaApplication236 obj = new JavaApplication236();
        System.out.println("Invoice ID: " + obj.getInvoiceID());
        System.out.println("Old Price: " + obj.getTotalInvoice());

        obj.setDiscount(5.5);
        obj.setTotalInvoice(200);

        System.out.println("Discount: " + obj.getDiscount());
        System.out.println("New Price: " + obj.getTotalInvoice());
        System.out.println("Price After Discount: "
                + obj.calculateDiscountPrice());
    }
}
